# Address of the backend API in production, e.g. https://rokto-lagbe-api.onrender.com
# Leave empty in development (Vite forwards /api to localhost:5000).
VITE_API_URL=

# Google sign-in (OAuth client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Log users out after this many minutes without activity (default 30).
# A warning with a countdown appears one minute before. Restart `npm run dev` after changing it.
VITE_SESSION_TIMEOUT_MINUTES=30
