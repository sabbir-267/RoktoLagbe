PORT=5000
NODE_ENV=development
MONGO_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google sign-in (same Client ID as client/.env VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=1085976783886-vnd8ghllkgrjkl086np9qumojs9dtakb.apps.googleusercontent.com

# Email (verification + password reset). Leave empty in development to print emails in the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = a 16-character App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RoktoLagbe <no-reply@example.com>"

# Request text parsing: auto (AI if ANTHROPIC_API_KEY is set, else the free offline parser), rules, or ai
PARSER_ENGINE=auto

# AI consultant chatbot: auto (Claude if ANTHROPIC_API_KEY is set, else the free offline assistant), offline, or ai
ASSISTANT_ENGINE=auto
# Claude model for the chatbot (default claude-opus-5-5; claude-haiku-5-5 is much cheaper)
CHAT_MODEL=claude-opus-5-5
